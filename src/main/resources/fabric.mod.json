{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "0.2.0.itisyan.patch5",
  "name": "HTSL Reborn Patched (v5)",
  "description": "Fabric mod that makes programming in Hypixel Housing easier.\n\nThis is an unofficial patched build of HTSL Reborn, based on the original project by redstone-llc.",
  "authors": [
    "Wekend",
    "Sin_ender",
	"",
	"Itisyan (patch fork)"
  ],
  "contact": {
    "homepage": "https://redstone.llc/",
    "sources": "https://github.com/Itisyan/HTSLReborn",
    "issues": "https://github.com/Itisyan/HTSLReborn/issues"
  },
  "license": "LGPL-3.0",
  "icon": "assets/htslreborn/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "llc.redstone.htslreborn.HTSLReborn"
      }
    ]
  },
  "mixins": [
    "htslreborn.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "minecraft": "${minecraft}",
    "fabric-api": ">=${fabric_api}",
    "fabric-language-kotlin": ">=${fabric_language_kotlin}",
    "systemsapi": ">=${systemsapi}",
    "owo-lib": ">=${owo_lib}"
  }
}